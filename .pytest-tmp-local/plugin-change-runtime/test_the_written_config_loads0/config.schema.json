{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NucleaMind 实例配置",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string",
      "description": "本文件的 schema 引用；运行期忽略。"
    },
    "turn": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_iterations": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "default": 16
        },
        "max_tool_calls_per_turn": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "default": 48
        },
        "tool_timeout_ms": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "default": 120000
        },
        "tool_result_max_bytes": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "default": 65536
        },
        "turn_timeout_ms": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "default": 900000
        },
        "context_max_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "exclusiveMinimum": 0,
          "default": null
        }
      }
    },
    "workspace": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "root": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        }
      }
    },
    "routing": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "command_prefix": {
          "type": "string",
          "default": "/"
        },
        "session_concurrency": {
          "type": "string",
          "default": "queue",
          "enum": [
            "queue",
            "merge",
            "reject"
          ]
        },
        "queue_max_size": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "default": 32
        },
        "dedup_capacity": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "default": 4096
        },
        "dedup_ttl_ms": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "default": 600000
        },
        "channel_concurrency": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "default": 64
        },
        "channel_queue_max_size": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "default": 32
        }
      }
    },
    "plugins": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "disable": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "stop_timeout_ms": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "default": 5000
        }
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "config": {
            "type": "object"
          },
          "secrets": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "on_disable": {
            "type": "string",
            "enum": [
              "restore_builtin",
              "leave_missing"
            ],
            "description": "这个插件被 plugins.disable 关掉后，它覆盖过的能力怎么办。只在该插件声明了 overrides 时需要写。"
          }
        }
      }
    },
    "hooks": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "observer_timeout_ms": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "default": 2000
        },
        "interceptor_timeout_ms": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "default": 5000
        }
      }
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "provider_timeout_ms": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "default": 3000
        },
        "compactor": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "compactor_timeout_ms": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "default": 3000
        }
      }
    },
    "memory": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "provider": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "recall_limit": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "default": 5
        },
        "recall_timeout_ms": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "default": 3000
        },
        "fragment_priority": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "default": 100
        },
        "on_failure": {
          "type": "string",
          "default": "degrade",
          "enum": [
            "degrade",
            "fail"
          ]
        }
      }
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "provider": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "name": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        }
      }
    },
    "retry": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_attempts": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "default": 3
        },
        "base_delay_ms": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "default": 500
        },
        "max_delay_ms": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "default": 8000
        },
        "retry_empty_response": {
          "type": "boolean",
          "default": true
        }
      }
    },
    "logging": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "level": {
          "type": "string",
          "default": "info"
        },
        "file_enabled": {
          "type": "boolean",
          "default": true
        }
      }
    }
  }
}
